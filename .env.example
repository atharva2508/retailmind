# Copy to .env (never commit .env). Spring Boot does not read .env itself:
# set these as environment variables or in your IDE run configuration.
DB_USER=postgres
DB_PASSWORD=change-me-long-random
JWT_SECRET=generate-with-openssl-rand-base64-48
# Dev only. Leave SEED_ENABLED unset in any shared or production environment.
SEED_ENABLED=true
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_REVIEWER_PASSWORD=
SEED_USER_PASSWORD=
