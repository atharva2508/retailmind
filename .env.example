# Copy to .env (never commit .env). Docker compose reads it, and Spring Boot reads it
# through spring.config.import when the app starts from the project folder.
DB_USER=postgres
DB_PASSWORD=change-me-long-random
JWT_SECRET=generate-with-openssl-rand-base64-48
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional. Without it the chat answers by keyword routing instead of Claude.
ANTHROPIC_API_KEY=
# Dev only. Leave SEED_ENABLED unset in any shared or production environment.
SEED_ENABLED=true
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_REVIEWER_PASSWORD=
SEED_USER_PASSWORD=
